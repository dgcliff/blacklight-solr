<?xml version="1.0" encoding="UTF-8" ?>
<config>
  <!-- NOTE: various comments and unused configuration possibilities have been purged
     from this file.  Please refer to http://wiki.apache.org/solr/SolrConfigXml,
     as well as the default solrconfig file included with Solr -->

  <abortOnConfigurationError>${solr.abortOnConfigurationError:true}</abortOnConfigurationError>

  <luceneMatchVersion>6.1.0</luceneMatchVersion>

  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.StandardDirectoryFactory}"/>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.core0.data.dir:}</str>
    </updateLog>
  </updateHandler>

  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <!-- solr lib dirs -->
  <lib dir="${solr.install.dir:../../../..}/contrib/analysis-extras/lib" />
  <lib dir="${solr.install.dir:../../../..}/contrib/analysis-extras/lucene-libs" />

  <dataDir>${solr.data.dir:}</dataDir>

  <requestHandler name="search" class="solr.SearchHandler" default="true">
    <!-- default values for query parameters can be specified, these
         will be overridden by parameters in the request
      -->
     <lst name="defaults">
       <str name="defType">edismax</str>
       <str name="echoParams">explicit</str>
       <str name="q.alt">*:*</str>
       <str name="mm">2&lt;-1 5&lt;-2 6&lt;90%</str>
       <int name="qs">1</int>
       <int name="ps">2</int>
       <float name="tie">0.01</float>
       <!-- this qf and pf are used by default, if not otherwise specified by
            client. The default blacklight_config will use these for the
            "keywords" search. See the author_qf/author_pf, title_qf, etc
            below, which the default blacklight_config will specify for
            those searches. You may also be interested in:
            http://wiki.apache.org/solr/LocalParams
       -->
       <!-- title_variant_tesim carries the alternative, uniform, translated and
            abbreviated titles Atlas indexes. Boosted below the primary title: a
            variant is a real way to find a record, but a match on the title a
            record leads with is the better hit. identifier_tesim is the DOI or
            call number a reader pastes in whole, unboosted because an
            identifier match is exact or it is nothing.

            subject_title_tesim is a work a record is ABOUT, and contents_tesim
            is its chapter list. Both unboosted. A subject title should not
            compete with the record's own title, and a contents list is long and
            keyword-dense enough that any boost would let it outrank a real
            abstract.

            descriptive_keywords_tesim holds the subjects, names, genre,
            publisher and place: v1 searched them, and v2 facets them. It is
            boosted below the abstract, because a heading is weaker evidence
            than prose, and a keyword-dense subject list would otherwise
            outrank a real description.

            title_stem_tesim and description_stem_tesim are stemmed twins, so
            "whales" finds "The whale". Each is boosted at half its original,
            and the original stays in the list: a record using the reader's
            exact form still ranks above one that matches only after stemming.
            dismax takes the best field per word, so a word found in both
            fields is not counted twice.

            All these notes sit outside the element on purpose. A comment inside it
            risks a parser reading only the text before the comment, and that
            failure is silent: search simply stops matching.
       -->
        <str name="qf">
	  title_tsim^10
	  title_stem_tesim^5
	  title_plain_tsim
	  title_variant_tesim^4
          description_tsim^5
          description_stem_tesim^2.5
          alternate_ids_tsim^3
	  identifier_tesim
	  subject_title_tesim
	  contents_tesim
	  descriptive_keywords_tesim^2
	  full_text_tesimv
        </str>
	<!-- A Person is a first-class catalog result, but on an empty query every
	     doc scores exactly 1.0, so Blacklight's default "score desc,
	     created_at_dtsi desc" sort ranks purely by recency, so a bulk People
	     import floats all of them above the whole repository. Demote a Person
	     multiplicatively so they sort below everything else once scores tie.

	     0.9 and not lower: on an empty query ANY factor below 1 separates the
	     groups completely, while a harder demotion starts losing real searches.
	     Measured on a name query against a Work titled after that same person,
	     0.5 and 0.1 both rank the Work above the person; 0.9 does not. -->
	<str name="boost">if(exists(query({!v='internal_resource_tesim:Person'})),0.9,1)</str>
	<str name="pf">
	  title_tsim^20
          full_text_tesimv^10
        </str>

       <str name="author_qf">
          author_tsim
       </str>
       <str name="author_pf">
       </str>
       <str name="title_qf">
	  title_tsim
       </str>
       <str name="title_pf">
       </str>
       <str name="subject_qf">
          subject_tsim
       </str>
       <str name="subject_pf">
       </str>

       <str name="fl">
         *,
         score
       </str>

       <str name="facet">true</str>
       <str name="facet.mincount">1</str>
<!--       <str name="facet.limit">10</str>-->
       <str name="facet.field">active_fedora_model_ssi</str>
       <str name="facet.field">subject_ssim</str>

     </lst>
  </requestHandler>

  <requestHandler name="permissions" class="solr.SearchHandler" >
    <lst name="defaults">
      <str name="facet">off</str>
      <str name="echoParams">all</str>
      <str name="rows">1</str>
      <str name="q">{!raw f=id v=$id}</str> <!-- use id=666 instead of q=id:666 -->
      <str name="fl">
        id,
        access_ssim,
        discover_access_group_ssim,discover_access_person_ssim,
        read_access_group_ssim,read_access_person_ssim,
        edit_access_group_ssim,edit_access_person_ssim,
        depositor_ti,
        embargo_release_date_dtsi
        inheritable_access_ssim,
        inheritable_discover_access_group_ssim,inheritable_discover_access_person_ssim,
        inheritable_read_access_group_ssim,inheritable_read_access_person_ssim,
        inheritable_edit_access_group_ssim,inheritable_edit_access_person_ssim,
        inheritable_embargo_release_date_dtsi
      </str>
    </lst>
  </requestHandler>

  <requestHandler name="standard" class="solr.SearchHandler">
     <lst name="defaults">
       <str name="echoParams">explicit</str>
       <str name="defType">lucene</str>
     </lst>
  </requestHandler>

  <requestHandler name="/replication" class="solr.ReplicationHandler" startup="lazy" />

  <requestDispatcher handleSelect="true" >
    <requestParsers enableRemoteStreaming="true" multipartUploadLimitInKB="2048" />
  </requestDispatcher>

  <requestHandler name="/analysis/field" startup="lazy" class="solr.FieldAnalysisRequestHandler" />
</config>
